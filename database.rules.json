{
  "rules": {
    "events": {
      "$eventCode": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren() || newData.val() === null",
        "scores": {
          "$scoreKey": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 30 && $scoreKey.matches(/^p[0-9]+_h[0-9]+$/)"
          }
        },
        "holeBetStake": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "birdieUnitVal": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "matchStake": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "nassauStake": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "wolfPointVal": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "stablefordPointVal": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "dotPointVal": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "skinsBuyIn": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "wolfLoneMult": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "wolfBlindMult": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "sideMatches": {
          "$matchId": {
            "stake": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            }
          }
        }
      }
    },
    "trips": {
      "$tripCode": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren() || newData.val() === null"
      }
    },
    "tournaments": {
      "$tourneyCode": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren() || newData.val() === null"
      }
    },
    "global_courses": {
      ".read": true,
      "$courseId": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length > 0"
      }
    },
    "app_settings": {
      ".read": true,
      ".write": false
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
