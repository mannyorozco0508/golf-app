# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
#
# UNCOMMENTED 2026-10-01 so it cannot be committed by accident. It is NOT in the
# repo and never has been (empty git log for the path), and the Android build does
# not need it: android/app/build.gradle applies the com.google.gms.google-services
# plugin only inside a try/catch that reads the file first, so its absence logs one
# line and the build proceeds. Nothing on Android uses native Firebase either - the
# plugin set is @capacitor/app, @capacitor/filesystem and @capacitor/share, and
# @capacitor-firebase/authentication is iOS-only by the capacitor.config.ts
# allowlist.
#
# WHEN ANDROID DOES GET NATIVE SIGN-IN this line is the thing to revisit, and it is
# a decision rather than an obstacle: the iOS twin, GoogleService-Info.plist, is
# COMMITTED on purpose (see ios/.gitignore for the reasoning - nothing in it is a
# secret and a tree without it ships a binary with Firebase unconfigured). If
# Android goes the same way, drop this line rather than reaching for git add -f.
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor
capacitor-cordova-android-plugins

# Copied web assets
app/src/main/assets/public

# Generated Config files
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml
