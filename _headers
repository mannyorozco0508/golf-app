# Cloudflare Pages response headers (website-d, Nov 10).
# The service worker script is revalidated on every update check, so a
# returning visitor picks up a new worker (and its cache version) at once.
# Live sent max-age=14400 for /sw.js. Chrome and Safari already bypass the
# HTTP cache for the worker script by default (updateViaCache 'imports'), and
# pwa-boot.js now registers with updateViaCache: 'none'; this covers anything
# that does not.
/sw.js
  Cache-Control: no-cache

# Cloudflare Pages response headers (P1-e, 2026-11-10).
#
# The app-link association file must be served as application/json with no
# redirect. apple-app-site-association has no extension, so Pages would
# otherwise send it as application/octet-stream. assetlinks.json is held back
# until the app ships the in-app card (2.0.6; Manny 2026-11-10). An hour's cache: a changed file reaches
# Apple's and Google's verifiers the same day.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

